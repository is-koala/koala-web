# Genel site adresi — metadata, canonical ve sitemap için zorunlu.
NEXT_PUBLIC_SITE_URL=https://iskoala.com

# Mobil uygulamanın flavor'a göre custom URL şeması için zorunlu.
NEXT_PUBLIC_APP_URL_SCHEME=koala

# Android intent ve Play Store yedeği için opsiyonel paket kimliği.
NEXT_PUBLIC_ANDROID_PACKAGE_ID=com.iskoala.koala

# Uygulama yayımlandığında App Store yedeği için opsiyonel sayısal kimlik.
NEXT_PUBLIC_IOS_APP_STORE_ID=

# Backend kök adresi. Yalnız Next.js sunucu/BFF katmanı okur; sırdır ve
# NEXT_PUBLIC_ öneki almaz, aksi hâlde tarayıcı bundle'ına girer.
API_URL=https://api-staging.iskoala.com

# Backend özel bir S3-uyumlu depoya (R2/MinIO) imzalı kanıt URL'si üretiyorsa
# yalnız güvenilen HTTPS origin'lerini virgülle ayırın. AWS S3 origin'leri yerleşik kabul edilir.
EVIDENCE_STORAGE_ORIGINS=

# BFF'nin backend, oturum yenileme veya özel depo yanıtını en fazla bekleyeceği süre (ms).
BFF_UPSTREAM_TIMEOUT_MS=15000

# Yalnız harita karoları için HTTP referrer kısıtlı Maps JavaScript API anahtarı.
# Gerçek değer tracked dosyalara yazılmaz; her ortam ayrı anahtar kullanır.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Universal Links: Application Identifier Prefix + bundle kimliği. Public metadatalardır.
APPLE_APP_IDENTIFIER=

# Android App Links: package adı ve Play App Signing sertifikasının SHA-256 parmak izi.
ANDROID_APP_LINKS_PACKAGE_NAME=com.iskoala.koala
ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=

# Hata izleme: her ortam ayrı Sentry projesi kullanır. DSN public kimliktir;
# SENTRY_AUTH_TOKEN yalnız build secret store'da tutulur.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sağlık ucunda gösterilen ve X-App-Version olarak backend'e giden sürüm.
# Backend sürüm kapısı okuyabilsin diye noktayla ayrılmış sayılarla başlar.
APP_VERSION=0.1.0
GIT_SHA=unknown
