{
  "name": "koala-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker-contract": "sh ops/test-docker-public-env-contract.sh",
    "test:e2e": "playwright test && playwright test --config playwright.messaging-safety.config.ts && npm run test:e2e:sitemap-production",
    "test:e2e:sitemap-production": "SITEMAP_PRODUCTION_HTTP=1 playwright test --config playwright.sitemap-production.config.ts",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts tests/e2e/keyboard.spec.ts",
    "test:performance": "lhci autorun"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
